{
	"modName": "SkyrimNet_DialogueScenarioEditor",
	"displayName": "$DSE_ModName",
	"minMcmVersion": 9,
	"cursorFillMode": "topToBottom",
	"content": [
		{
			"type": "header",
			"text": "$DSE_HeaderPage"
		},
		{
			"id": "iHotkey:General",
			"type": "keymap",
			"text": "$DSE_PageKey",
			"help": "$DSE_PageKeyHelp",
			"valueOptions": {
				"sourceType": "ModSettingInt"
			}
		},
		{
			"type": "header",
			"text": "$DSE_HeaderScenario"
		},
		{
			"id": "iTriggerKey:General",
			"type": "keymap",
			"text": "$DSE_TriggerKey",
			"help": "$DSE_TriggerKeyHelp",
			"valueOptions": {
				"sourceType": "ModSettingInt"
			}
		},
		{
			"id": "iFramework:General",
			"type": "enum",
			"text": "$DSE_Framework",
			"help": "$DSE_FrameworkHelp",
			"valueOptions": {
				"options": ["$DSE_FrameworkAuto", "$DSE_FrameworkOStim", "$DSE_FrameworkSexLab"],
				"sourceType": "ModSettingInt"
			}
		}
	]
}
